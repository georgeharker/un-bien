[Unit]
Description=un-bien launcher daemon
Documentation=https://docs.georgeharker.com/un-bien
After=default.target

[Service]
Type=simple
ExecStart={NODE} {PRESENCE}
Restart=on-failure
RestartSec=5s
StandardOutput=journal
StandardError=journal
# Inherit the user's shell PATH so `pi --mode rpc` resolves to the same
# binary it would in an interactive shell (npm-global / Homebrew / etc.).
Environment="PATH={PATH}"
Environment="HOME={HOME}"

[Install]
WantedBy=default.target
