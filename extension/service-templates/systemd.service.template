[Unit]
Description=un-bien launcher daemon
Documentation=https://docs.georgeharker.com/un-bien
After=default.target

[Service]
Type=simple
ExecStart={NODE} {PRESENCE}
Restart=on-failure
RestartSec=5s
StandardOutput=journal
StandardError=journal
# Inherit the user's shell PATH so `tmux`/`herdr` (remote-launch backends)
# and `pi` resolve to the same binaries they would in an interactive shell
# (npm-global / Homebrew / etc.).
Environment="PATH={PATH}"
Environment="HOME={HOME}"

[Install]
WantedBy=default.target
