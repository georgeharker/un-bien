<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- un-bien launcher daemon. Generated by `unbien install`. -->
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>dev.unbien.launcher</string>

  <key>ProgramArguments</key>
  <array>
    <string>{NODE}</string>
    <string>{PRESENCE}</string>
  </array>

  <key>RunAtLoad</key>
  <true/>
  <key>KeepAlive</key>
  <true/>

  <key>StandardOutPath</key>
  <string>{LOG}</string>
  <key>StandardErrorPath</key>
  <string>{LOG}</string>

  <key>EnvironmentVariables</key>
  <dict>
    <!-- Inherit the user's shell PATH so `tmux`/`herdr` (the remote-launch
         backends) and `pi` resolve the same way they would in Terminal.app
         (Homebrew / npm-global / etc.). -->
    <key>PATH</key>
    <string>{PATH}</string>
    <key>HOME</key>
    <string>{HOME}</string>
  </dict>
</dict>
</plist>
